# ── Azure / Power BI Auth ─────────────────────────────────────────────────────
# Your Azure Active Directory tenant ID
AZURE_TENANT_ID=<your-tenant-id>

# Optional: service principal for CI/CD (leave blank for interactive az login)
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# ── Workspace ─────────────────────────────────────────────────────────────────
# Human-readable workspace name (used by scripts to resolve the workspace ID)
PBI_WORKSPACE_NAME=<your-workspace-name>

# Resolved at runtime via 'az rest' — do NOT hardcode a GUID here
PBI_WORKSPACE_ID=

# ── Fiscal Calendar ───────────────────────────────────────────────────────────
# Calendar pattern: standard | 445 | 454 | 544 | 13period
#   standard  — month-aligned (Jan/Apr/Jul/Oct fiscal year starts)
#   445       — 4+4+5 weeks per quarter, week-anchored
#   454       — 4+5+4 weeks per quarter, week-anchored
#   544       — 5+4+4 weeks per quarter, week-anchored
#   13period  — 13 × 4-week periods, week-anchored
FISCAL_CALENDAR_PATTERN=445

# Nominal fiscal year start date (YYYY-MM-DD).
# For week-based patterns the function anchors to the nearest WeekStartDay
# on or before this date.
FISCAL_YEAR_START_DATE=2025-02-01

# Week start day for week-based calendars: Saturday | Sunday | Monday
# Most US retail: Saturday. UK/EU retail: Monday.
FISCAL_WEEK_START_DAY=Saturday

# Number of fiscal years to generate in the week-based calendar
FISCAL_NUMBER_OF_YEARS=5

# Locale for month/day names in the calendar
CALENDAR_CULTURE=en-US
