    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Welcome to Infographic Designer 1.7",
                    "textStyle": {
                      "fontSize": "12pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Starting from V1.6, Infographic Designer is built upon Power BI Visuals API V1.8.",
                    "textStyle": {
                      "fontSize": "12pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "A new GUID is used for Infographic Designer, so you need to manually update your existing reports:",
                    "textStyle": {
                      "fontSize": "12pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "(1) Download the custom visual package.",
                    "textStyle": {
                      "fontSize": "12pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "(2) In ",
                    "textStyle": {
                      "fontSize": "12pt"
                    }
                  },
                  {
                    "value": "Visualization Pane",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "12pt"
                    }
                  },
                  {
                    "value": ", import the visual into your report. (You will see two visuals with same icon. Their display names are different: the old one is \"Infographic Designer\", while the new one is \"Infographic Designer 1.5\".)",
                    "textStyle": {
                      "fontSize": "12pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "(3) Select visuals created with old "
                  },
                  {
                    "value": "Infographic Designer",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "12pt"
                    }
                  },
                  {
                    "value": ", and then convert them to ",
                    "textStyle": {
                      "fontSize": "12pt"
                    }
                  },
                  {
                    "value": "Infographic Designer 1.5",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "12pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "(4) In ",
                    "textStyle": {
                      "fontSize": "12pt"
                    }
                  },
                  {
                    "value": "Visualization Pane",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "12pt"
                    }
                  },
                  {
                    "value": ", delete a custom visual. Choose ",
                    "textStyle": {
                      "fontSize": "12pt"
                    }
                  },
                  {
                    "value": "Infographic Designer",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "12pt"
                    }
                  },
                  {
                    "value": ", and make sure there's no visual associated with it.",
                    "textStyle": {
                      "fontSize": "12pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "This is a one time action. In future, your reports will be automatically updated once there's a new version.",
                    "textStyle": {
                      "fontSize": "12pt"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
    }
  }
