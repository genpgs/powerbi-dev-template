                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Decimals",
                    "textStyle": {
                      "fontWeight": "bold",
                      "textDecoration": "underline"
                    }
                  },
                  {
                    "value": ": The number of decimal places can be set in the Decimal Places box, next to the Display Units and Number Formats properties.  Enter the desired number of decimals (default value is 2)."
