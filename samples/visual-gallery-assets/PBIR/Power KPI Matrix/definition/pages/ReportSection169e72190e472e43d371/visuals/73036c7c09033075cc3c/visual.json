                    }
                  },
                  {
                    "value": "\" (example: 15%)",
                    "textStyle": {
                      "fontSize": "12pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Dollars",
                    "textStyle": {
