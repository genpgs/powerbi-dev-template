                "textRuns": [
                  {
                    "value": "- "
                  },
                  {
                    "value": "Expandable Categories.  ",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "Show or hide groups of metrics by using the Category features. Subtotal values may also be shown, useful for items in a category that are additive in nature."
