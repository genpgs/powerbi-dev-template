          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Power KPI Matrix",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "10.5pt"
                    }
                  },
                  {
                    "value": " enables balanced scorecards in Power BI and displays an unlimited number of metrics and KPIs in a single, customized list. ",
                    "textStyle": {
                      "fontSize": "10.5pt"
                    }
                  },
                  {
                    "value": "Power KPI Matrix is similar to the Power KPI custom visual in supporting the creation and display of KPI indicator symbols and values along with current and historical trends of actual and target values."
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "The tabular format of Power KPI Matrix allows for an unlimited number of metrics and KPIs in a single list.  While there are several other custom visuals available that also display lists of KPIs, Power KPI Matrix offers a few unique abilities:  ",
                    "textStyle": {
                      "fontFamily": "inherit",
                      "fontSize": "inherit"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Balanced Scorecards.  ",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "Present different types of metrics and non-additive key performance indicators (KPIs), such as financial, operational, and customer-focused measures, as rows in a single list. "
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " "
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Column-Based and Row-Based Sources. ",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "Use your existing data models with minimal transformation. Bind the visual to either column-based metric sources or tables with row-based metrics."
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Super flexible and Customize-able.  ",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "Control fine details such as the font and background colors for each individual cell, row, or column; number formats, types, and precision; line chart colors and styles; row and column heights, widths, and more."
                  }
                ]
              }
            ]
          }
        }
      ]
