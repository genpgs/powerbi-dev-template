                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "The number of decimal places may be customized for every value label, as well as the chart axes, data labels and tooltips. Set the number of decimals by going into the Format Pane of the custom visual and changing the value for Decimal Places, as appropriate. "
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "By default, the field will appear grayed out and disabled, with the text, \"Auto.",
                    "textStyle": {
                      "textDecoration": "underline"
                    }
                  },
                  {
                    "value": "\"  Rest assured, the field is not disabled and you may place your cursor directly into this field and type your desired value."
                  }
