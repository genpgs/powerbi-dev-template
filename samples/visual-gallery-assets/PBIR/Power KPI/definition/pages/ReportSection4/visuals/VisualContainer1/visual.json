  "visual": {
    "visualType": "textbox",
    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "A typical use case for a data model is to have one data series (column) for Actual KPI values and a second series that shows on the line chart for comparison and to establish the KPI Indicator and the KPI Indicator Value label (e.g., \"+5.2%\") that can show alongside the indicator symbol.",
                    "textStyle": {
                      "color": "#000000"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "The logic used by the Power KPI custom visual is based on the order the columns are dropped into the Values section of the Field view:",
                    "textStyle": {
                      "color": "#000000"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "* The ",
                    "textStyle": {
                      "color": "#000000"
                    }
                  },
                  {
                    "value": "first column",
                    "textStyle": {
                      "textDecoration": "underline",
                      "color": "#000000"
                    }
                  },
                  {
                    "value": " (",
                    "textStyle": {
                      "color": "#000000"
                    }
                  },
                  {
                    "value": "required) ",
                    "textStyle": {
                      "fontStyle": "italic",
                      "color": "#000000"
                    }
                  },
                  {
                    "value": "dropped into Values is treated as the ",
                    "textStyle": {
                      "color": "#000000"
                    }
                  },
                  {
                    "value": "KPI Actual Value ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "color": "#000000"
                    }
                  },
                  {
                    "value": "series",
                    "textStyle": {
                      "color": "#000000"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "* The "
                  },
                  {
                    "value": "second column",
                    "textStyle": {
                      "textDecoration": "underline",
                      "color": "#000000"
                    }
                  },
                  {
                    "value": " (",
                    "textStyle": {
                      "color": "#000000"
                    }
                  },
                  {
                    "value": "optional",
                    "textStyle": {
                      "fontStyle": "italic",
                      "color": "#000000"
                    }
                  },
                  {
                    "value": ") dropped into Values becomes the primary comparison series for the KPI Values. ",
                    "textStyle": {
                      "color": "#000000"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "* An "
                  },
                  {
                    "value": "Axis (",
                    "textStyle": {
                      "fontWeight": "bold",
                      "color": "#000000"
                    }
                  },
                  {
                    "value": "x-axis) is also required for the visual to be drawn.  Typically, this is a Date/Time column and is referred to as ",
                    "textStyle": {
                      "color": "#000000"
                    }
                  },
                  {
                    "value": "KPI Date Value ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "color": "#000000"
                    }
                  },
                  {
                    "value": "in the visual properties, however you may also use categorical/text data types.",
                    "textStyle": {
                      "color": "#000000"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "By default, a variance % is automatically calculated between the two series and this variance is shown on the visual as as the ",
                    "textStyle": {
                      "color": "#000000"
                    }
                  },
                  {
                    "value": "KPI Indicator Value",
                    "textStyle": {
                      "fontWeight": "bold",
                      "color": "#000000"
                    }
                  },
                  {
                    "value": ".  You may choose to hide the KPI Indicator Value or you may also provide your own custom column or calculation to use as the KPI Indicator Value, such as the example at lower right that only displays a single series. Simply drop your desired column/calc on to the Field well called \"KPI Indicator Value.\" ",
                    "textStyle": {
                      "color": "#000000"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "See the next report tab for instructions to set up your KPI Indicator symbols and for info on including additional data series and variance calculations in your visual. ",
                    "textStyle": {
                      "fontSize": "inherit",
                      "color": "#000000"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
