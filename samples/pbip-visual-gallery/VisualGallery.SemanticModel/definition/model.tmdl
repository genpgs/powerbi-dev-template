model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

annotation PBI_QueryOrder = ["Calendar","DimProduct","DimCustomer","DimStore","FactSales","Flow","KpiTargets","PriceSeries","GanttTasks","HierarchyNodes","ScatterPoints","WordFrequency","BulletThresholds","fnCalendar","fnCalendarWeekBased","fnSeed"]

ref table Calendar
ref table FactSales
ref table DimProduct
ref table DimCustomer
ref table DimStore
ref table Flow
ref table KpiTargets
ref table PriceSeries
ref table GanttTasks
ref table HierarchyNodes
ref table ScatterPoints
ref table WordFrequency
ref table BulletThresholds

