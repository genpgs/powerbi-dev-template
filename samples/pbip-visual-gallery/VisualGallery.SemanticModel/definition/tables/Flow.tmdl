table Flow
	lineageTag: Flow

	measure 'Flow Value' = SUM(Flow[Value])
		formatString: #,0
		lineageTag: flow_value

	measure 'Distinct Source Nodes' = DISTINCTCOUNT(Flow[Source])
		formatString: #,0
		lineageTag: flow_sources

	measure 'Distinct Destination Nodes' = DISTINCTCOUNT(Flow[Destination])
		formatString: #,0
		lineageTag: flow_destinations

	column Source
		dataType: string
		lineageTag: Source
		summarizeBy: none
		sourceColumn: Source

	column Destination
		dataType: string
		lineageTag: Destination
		summarizeBy: none
		sourceColumn: Destination

	column Value
		dataType: double
		formatString: #,0
		lineageTag: flow_value_29
		summarizeBy: none
		sourceColumn: Value

	column LinkType
		dataType: string
		lineageTag: LinkType
		summarizeBy: none
		sourceColumn: LinkType

	column SourceType
		dataType: string
		lineageTag: SourceType
		summarizeBy: none
		sourceColumn: SourceType

	column TargetType
		dataType: string
		lineageTag: TargetType
		summarizeBy: none
		sourceColumn: TargetType

	column SourceLabels
		dataType: string
		lineageTag: SourceLabels
		summarizeBy: none
		sourceColumn: SourceLabels

	partition Flow = m
		mode: import
		source =
				let
				    // Every edge is written out literally. The previous version built these with
				    // List.Transform and positional access (e{0}, e{1}, ...), which this M
				    // engine accepts inconsistently: e{0} resolved while e{1} and later did
				    // not, and the failure surfaced only as error values in the table, never as
				    // a refresh error. This table is 14 static rows, so literals are both safer
				    // and easier to read than a transform.
				    Source = Table.FromRecords(
				        {
				            [Source = "Leads", Destination = "Enquiries", Value = 8400, LinkType = "Primary", SourceType = "Leads", TargetType = "Enquiries", SourceLabels = "1"],
				            [Source = "Enquiries", Destination = "Quotes", Value = 5600, LinkType = "Primary", SourceType = "Enquiries", TargetType = "Quotes", SourceLabels = "2"],
				            [Source = "Quotes", Destination = "Orders", Value = 4100, LinkType = "Primary", SourceType = "Quotes", TargetType = "Orders", SourceLabels = "3"],
				            [Source = "Orders", Destination = "Production", Value = 3700, LinkType = "Primary", SourceType = "Orders", TargetType = "Production", SourceLabels = "4"],
				            [Source = "Production", Destination = "Dispatch", Value = 3450, LinkType = "Primary", SourceType = "Production", TargetType = "Dispatch", SourceLabels = "5"],
				            [Source = "Dispatch", Destination = "Retail Sale", Value = 3180, LinkType = "Primary", SourceType = "Dispatch", TargetType = "Retail Sale", SourceLabels = "6"],
				            [Source = "Retail Sale", Destination = "Renewal", Value = 1620, LinkType = "Primary", SourceType = "Retail Sale", TargetType = "Renewal", SourceLabels = "7"],
				            [Source = "Leads", Destination = "Disqualified", Value = 3600, LinkType = "Secondary", SourceType = "Leads", TargetType = "Disqualified", SourceLabels = "-"],
				            [Source = "Enquiries", Destination = "Disqualified", Value = 2800, LinkType = "Secondary", SourceType = "Enquiries", TargetType = "Disqualified", SourceLabels = "-"],
				            [Source = "Quotes", Destination = "Lost", Value = 1500, LinkType = "Secondary", SourceType = "Quotes", TargetType = "Lost", SourceLabels = "-"],
				            [Source = "Orders", Destination = "Cancelled", Value = 400, LinkType = "Secondary", SourceType = "Orders", TargetType = "Cancelled", SourceLabels = "-"],
				            [Source = "Production", Destination = "Scrapped", Value = 180, LinkType = "Secondary", SourceType = "Production", TargetType = "Scrapped", SourceLabels = "-"],
				            [Source = "Dispatch", Destination = "Returned", Value = 270, LinkType = "Secondary", SourceType = "Dispatch", TargetType = "Returned", SourceLabels = "-"],
				            [Source = "Retail Sale", Destination = "Churned", Value = 1560, LinkType = "Secondary", SourceType = "Retail Sale", TargetType = "Churned", SourceLabels = "-"]
				        },
				        type table [
				            Source = text,
				            Destination = text,
				            Value = number,
				            LinkType = text,
				            SourceType = text,
				            TargetType = text,
				            SourceLabels = text
				        ])
				in
				    Source

