table Calendar
	lineageTag: Calendar
	dataCategory: Time

	measure 'Date Range Start' = MIN(Calendar[Date])
		formatString: Short Date
		lineageTag: cab90c04-e1bd-48da-8625-bed3910004c5

	measure 'Date Range End' = MAX(Calendar[Date])
		formatString: Short Date
		lineageTag: cbf7cac6-913d-4264-bedb-fb32126c250f

	measure 'Days in Selected Period' = COUNTROWS(VALUES(Calendar[Date]))
		formatString: #,0
		lineageTag: c43df7a3-e382-499d-817c-a4f7dc2c516a

	measure 'Sales MTD' =
			-- Calendar MTD/QTD/YTD, anchored on the last date that actually has fact
			-- data rather than on MAX(Date). A week-based calendar is generated as whole
			-- fiscal years, so it always overshoots the fact range at the end - here to
			-- 2026-01-30, so MAX(Calendar[CalendarYear]) is 2026 while the facts stop
			-- 2025-12-31. Anchoring on MAX() therefore filtered to a period with no sales
			-- and returned BLANK, which reads as a broken measure rather than an empty
			-- one. DATESMTD/DATESQTD/DATESYTD are avoided for the same reason: they
			-- look for 1 January, and this table is anchored on the Saturday on or
			-- before FiscalYearStartDate, so it begins 2022-01-29 and contains none.
			--
			-- The variable is named AsOf, not LastDate: DAX reserves LastDate and a
			-- VAR of that name fails with "The syntax for 'LastDate' is incorrect".
			VAR AsOf = MAX(FactSales[OrderDate])
			RETURN
			CALCULATE(
			    [Total Sales],
			    Calendar[CalendarYear] = YEAR(AsOf),
			    Calendar[CalendarMonthNumber] = MONTH(AsOf)
			)
		formatString: \$#,0.00
		lineageTag: calendar_mtd

	measure 'Sales QTD' =
			VAR AsOf = MAX(FactSales[OrderDate])
			RETURN
			CALCULATE(
			    [Total Sales],
			    Calendar[CalendarYear] = YEAR(AsOf),
			    Calendar[CalendarMonthNumber] <= MONTH(AsOf)
			)
		formatString: \$#,0.00
		lineageTag: calendar_qtd

	measure 'Sales YTD' =
			VAR AsOf = MAX(FactSales[OrderDate])
			RETURN
			CALCULATE(
			    [Total Sales],
			    Calendar[CalendarYear] = YEAR(AsOf)
			)
		formatString: \$#,0.00
		lineageTag: calendar_ytd

	measure 'Sales FYTD' =
			-- Fiscal YTD: FiscalYear plus FiscalWeekNumber bounds the week-based year
			-- correctly. TOTALYTD/DATESYTD follow calendar months and would disagree.
			VAR CurrentFY = MAX(Calendar[FiscalYear])
			VAR CurrentWk = MAX(Calendar[FiscalWeekNumber])
			RETURN
			CALCULATE(
			    [Total Sales],
			    Calendar[FiscalYear] = CurrentFY,
			    Calendar[FiscalWeekNumber] <= CurrentWk
			)
		formatString: \$#,0.00
		lineageTag: calendar_fytd

	measure 'Sales Rolling 12M' =
			VAR d = MAX(Calendar[Date])
			RETURN
			CALCULATE([Total Sales], DATESINPERIOD(Calendar[Date], d, -12, MONTH))
		formatString: \$#,0.00
		lineageTag: calendar_rolling12

	measure 'Sales Previous Year' = CALCULATE([Total Sales], SAMEPERIODLASTYEAR(Calendar[Date]))
		formatString: \$#,0.00
		lineageTag: calendar_pyy

	measure 'Sales YoY Change' = [Total Sales] - [Sales Previous Year]
		formatString: \$#,0.00
		lineageTag: calendar_yoychange

	measure 'Sales YoY %' = DIVIDE([Sales YoY Change], [Sales Previous Year])
		formatString: 0.0%
		lineageTag: calendar_yoypct

	column DateKey
		dataType: int64
		lineageTag: DateKey
		summarizeBy: none
		sourceColumn: DateKey

	column Date
		dataType: dateTime
		isKey
		formatString: Long Date
		lineageTag: Date
		summarizeBy: none
		sourceColumn: Date

		annotation UnderlyingDateTimeDataType = Date

	column CalendarYear
		dataType: int64
		lineageTag: CalendarYear
		summarizeBy: none
		sourceColumn: CalendarYear

	column CalendarMonthNumber
		dataType: int64
		lineageTag: CalendarMonthNumber
		summarizeBy: none
		sourceColumn: CalendarMonthNumber

	column CalendarMonth
		dataType: string
		lineageTag: CalendarMonth
		summarizeBy: none
		sourceColumn: CalendarMonth
		sortByColumn: CalendarMonthNumber

	column DayOfWeek
		dataType: string
		lineageTag: DayOfWeek
		summarizeBy: none
		sourceColumn: DayOfWeek

	column FiscalYear
		dataType: int64
		lineageTag: FiscalYear
		summarizeBy: none
		sourceColumn: FiscalYear

	column FiscalYearLabel
		dataType: string
		lineageTag: FiscalYearLabel
		summarizeBy: none
		sourceColumn: FiscalYearLabel
		sortByColumn: FiscalYear

	column FiscalYearStartDate
		dataType: dateTime
		formatString: Long Date
		lineageTag: FiscalYearStartDate
		summarizeBy: none
		sourceColumn: FiscalYearStartDate

		annotation UnderlyingDateTimeDataType = Date

	column FiscalWeekNumber
		dataType: int64
		lineageTag: FiscalWeekNumber
		summarizeBy: none
		sourceColumn: FiscalWeekNumber

	column FiscalPeriodNumber
		dataType: int64
		lineageTag: FiscalPeriodNumber
		summarizeBy: none
		sourceColumn: FiscalPeriodNumber

	column FiscalPeriodLabel
		dataType: string
		lineageTag: FiscalPeriodLabel
		summarizeBy: none
		sourceColumn: FiscalPeriodLabel
		sortByColumn: FiscalPeriodNumber

	column FiscalQuarterNumber
		dataType: int64
		lineageTag: FiscalQuarterNumber
		summarizeBy: none
		sourceColumn: FiscalQuarterNumber

	column FiscalQuarter
		dataType: string
		lineageTag: FiscalQuarter
		summarizeBy: none
		sourceColumn: FiscalQuarter
		sortByColumn: FiscalQuarterNumber

	column FiscalWeekOfPeriod
		dataType: int64
		lineageTag: FiscalWeekOfPeriod
		summarizeBy: none
		sourceColumn: FiscalWeekOfPeriod

	partition Calendar = m
		mode: import
		source =
				let
				    // Configuration mirrors config/fiscal-calendar.json.
				    // Change WeekPattern to "454", "544", or "13period" as needed.
				    // Change FiscalYearStartDate and WeekStartDay to match your business.
				    FiscalYearStartDate = #date(2025, 2, 1),
				    WeekPattern         = "445",
				    WeekStartDay        = "Saturday",
				    NumberOfYears       = 5,
				    // FiscalYear is the calendar year the fiscal year ends in
				    // ("endingYear", e.g. FY2025) or the year it starts in
				    // ("startingYear", e.g. FY2024). This drives both
				    // Calendar[FiscalYear] and Calendar[FiscalYearLabel].
				    FiscalYearLabelMode = "endingYear",
				    Culture             = "en-US",
				
				    // Date range. A partition must not read another table's data:
				    // Power BI does not track that dependency, so refreshing one
				    // table can deadlock waiting on the other. These literals span
				    // what FactSales generates (StartDate #date(2023,1,1) plus
				    // DayCount 1096). In a real model take them from the source
				    // query or a Power Query parameter instead.
				    _StartDate  = #date(2023, 1, 1),
				    _EndDate    = #date(2025, 12, 31),
				
				    // Anchor the calendar to the fiscal year that contains the FIRST
				    // fact date, then run forward far enough to cover the last one.
				    // Do not clamp the offset at zero: clamping can only ever move the
				    // calendar forward, which silently drops fact rows dated before
				    // FiscalYearStartDate.
				    CandidateStarts = List.Transform(List.Numbers(0, NumberOfYears + 1), (n) => Date.AddYears(FiscalYearStartDate, -n)),
				    // CandidateStarts runs newest first, so the FY start at or before
				    // _StartDate is the FIRST match. Taking List.Last here anchored the
				    // calendar to the oldest candidate instead, which is why the built
				    // table began at 2020-02-01 and was already short of the facts by
				    // the time it reached 2025.
				    CalendarStart   = List.First(List.Select(CandidateStarts, (fy) => fy <= _StartDate)),
				    // A fiscal year counts once it BEGINS on or before the last fact
				    // date, not once it has fully ended by then. Requiring the whole
				    // year to fit drops the FY that contains _EndDate, which is exactly
				    // the one holding the final fact rows: FY starting 2025-02-01 runs
				    // to 2026-01-31 and so never satisfied Date.AddYears(fy,1) <= _EndDate
				    // for _EndDate 2025-12-31, truncating the calendar a year short.
				    YearCovers      = (fy as date) as logical => fy <= _EndDate,
				    CalendarYears   = List.Count(List.Select(List.Transform(List.Numbers(1, NumberOfYears), (n) => Date.AddYears(CalendarStart, n - 1)), YearCovers)),
				
				    Calendar = fnCalendarWeekBased(CalendarStart, CalendarYears, WeekPattern, WeekStartDay, Culture, FiscalYearLabelMode)
				in
				    Calendar

