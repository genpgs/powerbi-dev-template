table Calendar
	lineageTag: Calendar
	dataCategory: Time

	measure 'Date Range Start' = MIN(Calendar[Date])
		formatString: Short Date
		lineageTag: cab90c04-e1bd-48da-8625-bed3910004c5

	measure 'Date Range End' = MAX(Calendar[Date])
		formatString: Short Date
		lineageTag: cbf7cac6-913d-4264-bedb-fb32126c250f

	measure 'Days in Selected Period' = COUNTROWS(VALUES(Calendar[Date]))
		formatString: #,0
		lineageTag: c43df7a3-e382-499d-817c-a4f7dc2c516a

	measure 'Sales MTD' = CALCULATE([Total Sales], DATESMTD(Calendar[Date]))
		formatString: \$#,0.00
		lineageTag: calendar-mtd

	measure 'Sales QTD' = CALCULATE([Total Sales], DATESQTD(Calendar[Date]))
		formatString: \$#,0.00
		lineageTag: calendar-qtd

	measure 'Sales YTD' = CALCULATE([Total Sales], DATESYTD(Calendar[Date]))
		formatString: \$#,0.00
		lineageTag: calendar-ytd

	measure 'Sales FYTD' =
			-- Fiscal YTD: FiscalYear plus FiscalWeekNumber bounds the week-based year
			-- correctly. TOTALYTD/DATESYTD follow calendar months and would disagree.
			VAR CurrentFY = MAX(Calendar[FiscalYear])
			VAR CurrentWk = MAX(Calendar[FiscalWeekNumber])
			RETURN
			CALCULATE(
			    [Total Sales],
			    Calendar[FiscalYear] = CurrentFY,
			    Calendar[FiscalWeekNumber] <= CurrentWk
			)
		formatString: \$#,0.00
		lineageTag: calendar-fytd

	measure 'Sales Rolling 12M' =
			VAR d = MAX(Calendar[Date])
			RETURN
			CALCULATE([Total Sales], DATESINPERIOD(Calendar[Date], d, -12, MONTH))
		formatString: \$#,0.00
		lineageTag: calendar-rolling12

	measure 'Sales Previous Year' = CALCULATE([Total Sales], SAMEPERIODLASTYEAR(Calendar[Date]))
		formatString: \$#,0.00
		lineageTag: calendar-pyy

	measure 'Sales YoY Change' = [Total Sales] - [Sales Previous Year]
		formatString: \$#,0.00
		lineageTag: calendar-yoychange

	measure 'Sales YoY %' = DIVIDE([Sales YoY Change], [Sales Previous Year])
		formatString: 0.0%
		lineageTag: calendar-yoypct

	column DateKey
		dataType: int64
		lineageTag: DateKey
		summarizeBy: none
		sourceColumn: DateKey

	column Date
		dataType: dateTime
		isKey
		formatString: Long Date
		lineageTag: Date
		summarizeBy: none
		sourceColumn: Date

		annotation UnderlyingDateTimeDataType = Date

	column CalendarYear
		dataType: int64
		lineageTag: CalendarYear
		summarizeBy: none
		sourceColumn: CalendarYear

	column CalendarMonthNumber
		dataType: int64
		lineageTag: CalendarMonthNumber
		summarizeBy: none
		sourceColumn: CalendarMonthNumber

	column CalendarMonth
		dataType: string
		lineageTag: CalendarMonth
		summarizeBy: none
		sourceColumn: CalendarMonth
		sortByColumn: CalendarMonthNumber

	column DayOfWeek
		dataType: string
		lineageTag: DayOfWeek
		summarizeBy: none
		sourceColumn: DayOfWeek

	column FiscalYear
		dataType: int64
		lineageTag: FiscalYear
		summarizeBy: none
		sourceColumn: FiscalYear

	column FiscalYearLabel
		dataType: string
		lineageTag: FiscalYearLabel
		summarizeBy: none
		sourceColumn: FiscalYearLabel
		sortByColumn: FiscalYear

	column FiscalYearStartDate
		dataType: dateTime
		formatString: Long Date
		lineageTag: FiscalYearStartDate
		summarizeBy: none
		sourceColumn: FiscalYearStartDate

		annotation UnderlyingDateTimeDataType = Date

	column FiscalWeekNumber
		dataType: int64
		lineageTag: FiscalWeekNumber
		summarizeBy: none
		sourceColumn: FiscalWeekNumber

	column FiscalPeriodNumber
		dataType: int64
		lineageTag: FiscalPeriodNumber
		summarizeBy: none
		sourceColumn: FiscalPeriodNumber

	column FiscalPeriodLabel
		dataType: string
		lineageTag: FiscalPeriodLabel
		summarizeBy: none
		sourceColumn: FiscalPeriodLabel
		sortByColumn: FiscalPeriodNumber

	column FiscalQuarterNumber
		dataType: int64
		lineageTag: FiscalQuarterNumber
		summarizeBy: none
		sourceColumn: FiscalQuarterNumber

	column FiscalQuarter
		dataType: string
		lineageTag: FiscalQuarter
		summarizeBy: none
		sourceColumn: FiscalQuarter
		sortByColumn: FiscalQuarterNumber

	column FiscalWeekOfPeriod
		dataType: int64
		lineageTag: FiscalWeekOfPeriod
		summarizeBy: none
		sourceColumn: FiscalWeekOfPeriod

	partition Calendar = m
		mode: import
		source =
				let
				    // Configuration mirrors config/fiscal-calendar.json.
				    // Change WeekPattern to "454", "544", or "13period" as needed.
				    // Change FiscalYearStartDate and WeekStartDay to match your business.
				    FiscalYearStartDate = #date(2025, 2, 1),
				    WeekPattern         = "445",
				    WeekStartDay        = "Saturday",
				    NumberOfYears       = 5,
				    // FiscalYear is the calendar year the fiscal year ends in
				    // ("endingYear", e.g. FY2025) or the year it starts in
				    // ("startingYear", e.g. FY2024). This drives both
				    // Calendar[FiscalYear] and Calendar[FiscalYearLabel].
				    FiscalYearLabelMode = "endingYear",
				    Culture             = "en-US",

				    // Derive the date range from the fact table.
				    // If you have no live model, replace with literal dates:
				    //   Calendar = fnCalendarWeekBased(FiscalYearStartDate, NumberOfYears, WeekPattern, WeekStartDay, Culture, FiscalYearLabelMode)
				    DateValues  = List.RemoveNulls(List.Transform(FactSales[OrderDate], each try Date.From(_) otherwise null)),
				    _StartDate  = if List.IsEmpty(DateValues) then error "No valid dates in FactSales[OrderDate]" else List.Min(DateValues),
				    _EndDate    = if List.IsEmpty(DateValues) then error "No valid dates in FactSales[OrderDate]" else List.Max(DateValues),

				    // Anchor the calendar to the fiscal year that contains the FIRST
				    // fact date, then run forward far enough to cover the last one.
				    // Do not clamp the offset at zero: clamping can only ever move the
				    // calendar forward, which silently drops fact rows dated before
				    // FiscalYearStartDate.
				    CandidateStarts = List.Transform(List.Numbers({0..NumberOfYears}), (n) => Date.AddYears(FiscalYearStartDate, -n)),
				    CalendarStart   = List.Last(List.Select(CandidateStarts, (fy) => fy <= _StartDate)),
				    YearCovers      = (fy as date) as logical => Date.AddYears(fy, 1) <= _EndDate,
				    CalendarYears   = List.Count(List.Select(List.Transform(List.Numbers({1..NumberOfYears}), (n) => Date.AddYears(CalendarStart, n - 1)), YearCovers)),

				    Calendar = fnCalendarWeekBased(CalendarStart, CalendarYears, WeekPattern, WeekStartDay, Culture, FiscalYearLabelMode)
				in
				    Calendar