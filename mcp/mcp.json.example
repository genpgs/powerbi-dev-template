{
  "_comment": "Copy this file to the correct location for your agent harness and remove this _comment key.",
  "_locations": {
    "antigravity-global":   "~/.config/antigravity/mcp.json",
    "antigravity-per-repo": ".antigravity/mcp.json  (repo root)",
    "vscode-copilot":       ".vscode/mcp.json  (repo root)",
    "claude-code":          "~/.claude/mcp.json  (global)"
  },
  "powerbi-modeling-mcp": {
    "type": "stdio",
    "command": "npx",
    "args": ["-y", "@microsoft/powerbi-modeling-mcp@latest", "--start"],
    "env": {
      "PBI_MODELING_MCP_ACCEPT_EULA": "true"
    },
    "_notes": [
      "Requires Node.js 18+ and npx on PATH.",
      "PBI_MODELING_MCP_ACCEPT_EULA: set to 'true' to pre-accept the Microsoft EULA for headless/agent workflows (https://go.microsoft.com/fwlink/?LinkId=2381247).",
      "On Windows: connects to a running Power BI Desktop instance automatically.",
      "On Linux: operates on local TMDL project folders offline, or connects to a Fabric workspace.",
      "See https://github.com/microsoft/powerbi-modeling-mcp for full docs."
    ]
  }
}
