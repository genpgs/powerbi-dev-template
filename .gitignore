# Power BI local artifacts (never commit these)
# The whole .pbi/ tree is Desktop-generated runtime state: settings, caches and the
# per-user editor layout. None of it belongs in version control, and the layout files in
# particular churn on every open/save, so tracking them produces noisy diffs.
**/.pbi/
*.pbix

# Diagram / layout state - Desktop rewrites these on every save, so they only create diff noise
diagramLayout.json
semanticModelDiagramLayout.json

# IDE folders Desktop may create next to the PBIP
.vscode/
.idea/

# Agent validation output
.bpa/
bpa-results.json
*-audit-report.md
*-audit-report.json

# Rendered-output verification (scripts/capture_report_screenshot.py, Windows-only).
# Regenerate locally; PNGs are throwaway evidence, not source.
artifacts/

# Environment / secrets
.env
secrets/

# Python
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

# Node
node_modules/
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# Editor
*.swp
*.swo

# Local sample data (large binaries; regenerate or fetch separately)
data/*.xlsx
data/*.csv
data/*.parquet

# Local source assets for extending the visual gallery; check in PBIR examples, not packages.
samples/visual-gallery-assets/
# Playwright CLI output (may contain credentials)
.playwright-cli/
# Personal local agent config (personal skills, tooling)
.claude/

# Custom visual packages (publisher binaries, e.g. Microsoft AppSource .pbiviz).
# VisualGallery reports reference custom visuals by GUID in
# report.json -> publicCustomVisuals; the packages themselves are pulled locally by
# scripts/extract_custom_visuals.ps1 and never committed.
*.pbiviz
**/CustomVisuals/
